# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage output
coverage/
test-results/
playwright-report/
blob-report/
.vitest/

# Tool caches
.vite/
.cache/
.turbo/
.eslintcache
*.timestamp-*.mjs

# Generated by the browser diagnostics in scripts/ — see the README.
scripts/shots/
scripts/*.png
scripts/probe/*.png

# Credentials. Panorama connects to a database, so a stray key or .env file is
# a real hazard; commit one deliberately with `git add -f` if you ever need to.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json

# Local, machine-specific overrides
*.local

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors. Shared workspace settings are allowed through; personal state is not.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*~

# macOS and Windows cruft
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Internal agent guidance
plans/
reports/
