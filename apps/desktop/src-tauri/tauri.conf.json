{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exasol Panorama",
  "version": "../../../package.json",
  "identifier": "com.exasol.panorama",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exasol Panorama",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#f1f3f5",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A spatial canvas for exploring data in Exasol.",
    "longDescription": "Tables, queries and charts as boxes on an infinite plane, drawn by the GPU, connected by lines that mean something.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNDkxNkMzRUEwN0M1QTYKUldTbXhRZnF3eFpKdXN5aUNuMXUrdlpsVk1FbDIrYUpqRmxiMjFuNjJjQWl4QVJZeTNmUmE5NFgK",
      "endpoints": [
        "https://github.com/exasol-labs/exasol-panorama/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
