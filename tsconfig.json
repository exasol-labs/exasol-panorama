{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": {
      "@panorama/core": ["./packages/core/src/index.ts"],
      "@panorama/core/*": ["./packages/core/src/*"],
      "@panorama/table": ["./packages/table/src/index.ts"],
      "@panorama/table/*": ["./packages/table/src/*"],
      "@panorama/exasol": ["./packages/exasol/src/index.ts"],
      "@panorama/exasol/*": ["./packages/exasol/src/*"],
      "@panorama/export": ["./packages/export/src/index.ts"],
      "@panorama/export/*": ["./packages/export/src/*"],
      "@panorama/worker": ["./packages/worker/src/index.ts"],
      "@panorama/worker/*": ["./packages/worker/src/*"],
      "@panorama/mcp": ["./packages/mcp/src/index.ts"],
      "@panorama/mcp/*": ["./packages/mcp/src/*"],
      "@panorama/renderer": ["./packages/renderer/src/index.ts"],
      "@panorama/renderer/*": ["./packages/renderer/src/*"],
      "@panorama/ui": ["./packages/ui/src/index.ts"],
      "@panorama/ui/*": ["./packages/ui/src/*"],
      "@panorama/test-support": ["./packages/test-support/src/index.ts"],
      "@panorama/test-support/*": ["./packages/test-support/src/*"]
    }
  },
  "include": ["./packages/*/src/**/*", "packages/*/test/**/*", "apps/*/src/**/*", "*.ts", "*.mts"]
}
